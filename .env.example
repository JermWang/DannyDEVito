# ===========================================
# SUPABASE DATABASE SETUP
# ===========================================
# 1. Go to https://supabase.com and create a new project
# 2. Go to Project Settings > Database > Connection string
# 3. Copy the "Transaction pooler" connection string (port 6543)
# 4. Replace [YOUR-PASSWORD] with your database password

DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# For Prisma migrations, use the direct connection (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# ===========================================
# PRIVY SERVER WALLET API
# ===========================================
# Get these from https://dashboard.privy.io
PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET="your-privy-app-secret"

# Authorization key for signing Privy requests (wallet actions)
# Format: wallet-auth:BASE64_PRIVATE_KEY or raw PEM


# Your external Phantom wallet for receiving swept profits and creator fees
# All extra profits from launches will be sent here via the admin sweep function
PROFIT_WALLET_PUBKEY=""

# Webhook signing secret (from Privy dashboard when creating webhook)
# Format: whsec_xxxxx
PRIVY_WEBHOOK_SIGNING_SECRET=""

# ===========================================
# TREASURY / ESCROW WALLET
# ===========================================
# Privy wallet ID for the treasury (created via Privy dashboard or API)
# This wallet holds SOL for launches and receives tokens
TREASURY_WALLET_ID=""

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
# Comma-separated list of admin wallet public keys
# Only these wallets can access /admin and trigger launches/distributions
ADMIN_WALLET_PUBKEYS=""

# ===========================================
# SOLANA RPC
# ===========================================
# Recommended: use a reliable paid RPC provider for production
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Solana cluster (mainnet-beta, devnet, testnet)
SOLANA_CLUSTER="mainnet-beta"
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"

# Optional: explicit CAIP2 chain ID
# mainnet-beta: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# devnet: solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_CAIP2=""

# ===========================================
# STAKING CONFIGURATION
# ===========================================
STAKE_UNLOCK_SECONDS=3600  # 1 hour unlock period for unstaking
DEVITO_TOKEN_MINT=""

# ===========================================
# TOKEN GATING (for Chat Logs)
# ===========================================
# Token mint address for holder verification
NEXT_PUBLIC_HOLDER_TOKEN_MINT=""
# Minimum token amount required to be considered a holder
NEXT_PUBLIC_HOLDER_MIN_AMOUNT="1"

# ===========================================
# OPENAI (for Danny chat)
# ===========================================
OPENAI_API_KEY="your-openai-api-key"

# ===========================================
# APP URL (for metadata)
# ===========================================
NEXT_PUBLIC_APP_URL="https://www.DannyDaDev.xyz"

# ===========================================
# SOCIAL LINKS
# ===========================================
NEXT_PUBLIC_TWITTER_URL=""

# ===========================================
# TOKEN CONTRACT ADDRESS
# ===========================================
# Official $DEVITO token contract address (for copy-to-clipboard feature)
NEXT_PUBLIC_TOKEN_CONTRACT=""

# ===========================================
# TWITTER/X API (for automated tweets)
# ===========================================
# Get these from https://developer.twitter.com/en/portal/dashboard
# You need a project with OAuth 1.0a User Context (Read and Write)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI=""
X_ACCESS_TOKEN=""

# ===========================================
# CRON SECRET (for Vercel cron jobs)
# ===========================================
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=""

# ===========================================
# OPENAI MODEL (optional)
# ===========================================
# Default: gpt-4o-mini (cheaper, faster)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL="gpt-4o-mini"
